          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "BunnyGuardianSpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [8, 0.4, 8],
          "CFrame": {
            "CFrame": {
              "position": [0, 0.2, 22],
              "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
            }
          },
          "Color": [1, 0.8, 0.88],
          "Material": "SmoothPlastic",
          "Duration": 0,
          "TopSurface": "Smooth"
        }
