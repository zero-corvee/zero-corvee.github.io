{
  "name": "Bunny Guardian Prototype",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "BunnyGuardian": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/ReplicatedStorage/Shared"
        },
        "Remotes": {
          "$className": "Folder",
          "UseAbility": { "$className": "RemoteEvent" },
          "BuyUpgrade": { "$className": "RemoteFunction" },
          "Notify": { "$className": "RemoteEvent" }
        },
        "GameState": { "$className": "Configuration" }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "BunnyGuardian": {
        "$path": "src/ServerScriptService/BunnyGuardian"
      }
    },

    "StarterPlayer": {
